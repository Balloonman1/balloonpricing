# Required in production: password for /admin
ADMIN_PASSWORD=
# Optional: separate secret for signing admin sessions (defaults to a hash of ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# Canonical site URL used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://balloonbluebook.com

# Optional: Supabase. When all three are set, Supabase is used for storage and user accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: force a storage backend when Supabase is not set: "blobs" or "memory"
BLUEBOOK_STORAGE=
