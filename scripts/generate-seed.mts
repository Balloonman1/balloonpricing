#!/usr/bin/env node
/**
 * Writes supabase/seed.sql: the default pricing configuration (version 1, active)
 * plus the manufacturer and model catalog. No comparable sales are seeded.
 *
 * Usage: node scripts/generate-seed.mts
 */
import { readFileSync, writeFileSync } from "node:fs";
import { DEFAULT_CONFIG } from "../src/lib/engine/defaults.ts";

const catalog = JSON.parse(readFileSync("src/data/model-catalog.json", "utf8"));
const q = (v: unknown) => (v === null || v === undefined ? "null" : `'${String(v).replace(/'/g, "''")}'`);
const n = (v: number | null | undefined) => (v === null || v === undefined ? "null" : String(v));

const lines: string[] = [];
lines.push("-- Generated by scripts/generate-seed.mts. Do not edit by hand.");
lines.push("begin;");
lines.push(
  `insert into public.valuation_configs (version, label, notes, snapshot, is_active, created_by) values (1, ${q(DEFAULT_CONFIG.label)}, 'Initial expert pricing assumptions', ${q(JSON.stringify(DEFAULT_CONFIG))}::jsonb, true, 'seed') on conflict (version) do nothing;`,
);
for (const m of catalog.manufacturers) {
  lines.push(`insert into public.manufacturers (name, is_primary) values (${q(m.name)}, ${m.primary ? "true" : "false"}) on conflict (name) do nothing;`);
  if (!m.models.length) continue;
  const values = m.models
    .map(
      (x: { model: string; volumeCuFt: number | null; category: string; count: number; yearMin: number | null; yearMax: number | null }) =>
        `(${q(x.model)}, ${n(x.volumeCuFt)}, ${q(x.category)}, ${x.count}, ${n(x.yearMin)}, ${n(x.yearMax)})`,
    )
    .join(",\n  ");
  lines.push(
    `insert into public.balloon_models (manufacturer_id, model, typical_volume_cuft, category, registry_count, year_min, year_max, source)
select m.id, v.model, v.vol::integer, v.cat, v.cnt::integer, v.ymin::integer, v.ymax::integer, 'Balloon History Archive registry (The HAB Database)'
from public.manufacturers m, (values
  ${values}
) as v(model, vol, cat, cnt, ymin, ymax)
where m.name = ${q(m.name)}
on conflict (manufacturer_id, model) do nothing;`,
  );
}
lines.push("commit;");
writeFileSync("supabase/seed.sql", lines.join("\n") + "\n");
console.log(`Wrote supabase/seed.sql with config v1 and ${catalog.manufacturers.length} manufacturers.`);
